@model CategoryDto

@{
    ViewData["Title"] = "Delete Category";
}

<h2>Delete Category</h2>

<div class="card p-4 shadow-sm rounded-lg bg-white">
    <h4>Are you sure you want to delete this category?</h4>

    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.Id</dd>

        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Created By</dt>
        <dd class="col-sm-9">@Model.CreatedBy</dd>

        <dt class="col-sm-3">Created At</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm tt")</dd>

        <dt class="col-sm-3">Updated At</dt>
        <dd class="col-sm-9">@(Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm tt") ?? "Not Updated")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-area="Admin" asp-controller="Category" asp-action="CategoryList" class="btn btn-secondary">Cancel</a>
    </form>
</div>