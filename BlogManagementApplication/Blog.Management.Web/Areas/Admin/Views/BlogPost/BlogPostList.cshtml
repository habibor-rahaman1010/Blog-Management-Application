@model PagedWithResult<BlogPostDto>

@{
    ViewData["Title"] = "Blog Post List";
    int currentPage = Model.PageIndex;
    int totalPages = (int)Math.Ceiling((double)Model.Total / Model.PageSize);
    int pageSize = Model.PageSize;
}

<div>
    <div class="d-flex justify-content-between align-items-center mb-4 px-3 pt-3">
        <a class="btn btn-success px-4 py-2 rounded-3 shadow-sm"
           asp-area="Admin"
           asp-controller="BlogPost"
           asp-action="BlogPostCreate">
            <i class="bi bi-plus-circle"></i> Create Blog Post
        </a>

        <h2 class="m-0">@ViewData["Title"]</h2>
    </div>

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark text-center">
            <tr>
                <th style="width:5%">No</th>
                <th>Cover Image</th>
                <th>Title</th>
                <th>Author Name</th>
                <th>Created At</th>
                <th>Updated At</th>
                <th style="width:20%">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Any())
            {
                int index = (currentPage - 1) * pageSize + 1;
                foreach (var post in Model.Items)
                {
                    <tr>

                        <td class="text-center">@index</td>
                        <td>
                            <img src="@Url.Content("~/Uploads/BlogImages/" + post.CoverImageUrl)"
                                 alt="Cover Image"
                                 style="width:80px; height:80px; object-fit:cover;" />
                        </td>


                        <td>@post.Title</td>
                        <td>@post.Author</td>
                        <td>@post.CreatedAt.ToString("yyyy-MM-dd hh:mm:ss tt")</td>
                        <td>@(post.UpdatedAt.HasValue? post.UpdatedAt.Value.ToString("yyyy-MM-dd hh:mm tt") : "Not Updated")</td>
                        <td class="text-center">
                            <a asp-area="Admin" asp-controller="BlogPost" asp-action="BlogPostUpdate" asp-route-id="@post.Id"
                               class="btn btn-sm btn-primary me-1">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                            <a asp-area="Admin" asp-controller="BlogPost" asp-action="BlogPostDetails" asp-route-id="@post.Id"
                               class="btn btn-sm btn-info text-white me-1">
                                <i class="bi bi-eye"></i> View
                            </a>

                            <form asp-area="Admin"
                                  asp-controller="BlogPost"
                                  asp-action="BlogPostDelete"
                                  asp-route-id="@post.Id"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this post?');"
                                  style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger text-white me-1">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>

                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">No blog post found.</td>
                </tr>
            }
        </tbody>
    </table>


    @if (totalPages > 1)
    {
        <nav aria-label="Category pagination">
            <ul class="pagination justify-content-center">
                <!-- Previous Button -->
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-controller="BlogPost" asp-action="BlogPostList" asp-area="Admin"
                       asp-route-pageIndex="@(currentPage - 1)">Previous</a>
                </li>

                <!-- Page Numbers -->
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-controller="BlogPost" asp-action="BlogPostList" asp-area="Admin"
                           asp-route-pageIndex="@i">@i</a>
                    </li>
                }

                <!-- Next Button -->
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-controller="BlogPost" asp-action="BlogPostList" asp-area="Admin"
                       asp-route-pageIndex="@(currentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script>
            $(document).ready(function () {
            setTimeout(function () {
                $('#response-alert').fadeOut('slow');
            }, 3000);
        });
    </script>
}