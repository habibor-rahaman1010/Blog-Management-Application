@model BlogPostCreateDto;

@{
    ViewData["Title"] = "Create Blog Post";
}

<div class="container pt-3">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title">Create Blog Post</h3>
        </div>

        <form asp-antiforgery="true" asp-area="Admin" asp-controller="BlogPost" asp-action="BlogPostCreate" method="post" enctype="multipart/form-data">
            <div class="card-body">

                <!-- Title -->
                <div class="form-group">
                    <label for="Title">Title</label>
                    <input asp-for="Title" class="form-control" placeholder="Enter blog title" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <!-- Content -->
                <div class="form-group">
                    <label for="Content">Content</label>
                    <textarea asp-for="Content" class="form-control" rows="4" placeholder="Write blog content here..."></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <!-- Author -->
                <div class="form-group">
                    <label for="Author">Author</label>
                    <input asp-for="Author" class="form-control" placeholder="Author name" />
                    <span asp-validation-for="Author" class="text-danger"></span>
                </div>

                <!-- IsActive -->
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label class="form-check-label" asp-for="IsActive">Is Active?</label>
                    <span asp-validation-for="IsActive" class="text-danger"></span>
                </div>

                <!-- Category Dropdown -->
                <div class="form-group mt-3">
                    <label for="CategoryId">Category</label>
                    <select asp-for="CategoryId" class="form-control" asp-items="Model.Categories"></select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <!-- Cover Image -->
                <div class="form-group">
                    <label asp-for="CoverImageFile" class="control-label">Cover Image*</label>
                    <div class="custom-file">
                        <label class="custom-file-label" asp-for="CoverImageFile">Choose your file</label>
                        <input style="width: 400px; cursor:pointer" asp-for="CoverImageFile" class="custom-file-input" id="productImage">
                        <p id="imageError"></p>
                    </div>
                    <p class="mt-2">Max File size: 5MB <br /> Allowed File: .jpeg, .jpg, .png <br /> Aspect ratio should be 1:1</p>
                    <span asp-validation-for="CoverImageFile" class="text-danger"></span>
                </div>

            </div>

            <div class="card-footer">
                <button type="submit" class="btn btn-primary">Submit</button>
            </div>

        </form>
    </div>
</div>

<!-- /.content -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const productImageInput = document.getElementById('productImage');
        const imageError = document.getElementById('imageError');

        productImageInput.addEventListener('change', (event) => {
            const file = event.target.files[0];

            if (file) {
                // Validate file size and aspect ratio
                if (file.size > 5 * 1024 * 1024) {
                    imageError.textContent = 'File size is too large.';
                    productImageInput.value = '';
                } else if (file.type.startsWith('image/') && file.width === file.height) {
                    // Handle successful upload or preview
                    imageError.textContent = '';
                    // ...
                } else {
                    imageError.textContent = 'Invalid image format or aspect ratio.';
                    productImageInput.value = '';
                }
            }
        });

        document.querySelector('.custom-file-input').addEventListener('change', function (e) {
            var fileName = e.target.files[0].name;
            var label = e.target.nextElementSibling;
            label.textContent = fileName;
        });
    </script>
}
