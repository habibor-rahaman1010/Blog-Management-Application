@model IEnumerable<ApplicationRole>

<style>
    .custom-table-bordered th,
    .custom-table-bordered td {
        border: 1px solid #dee2e6 !important;
    }
</style>

<div class="container-fluid px-5 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">User Roles</h2>
        <partial name="_ResponsePartial" />
        <a asp-area="Admin" asp-controller="UserManagement" asp-action="CreateRole" class="btn btn-success">Add New Role</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered custom-table-bordered mb-0">
            <thead class="table-light">
                <tr>
                    <th class="align-middle">Role Name</th>
                    <th class="align-middle">Normalized Name</th>
                    <th class="align-middle">Concurrency Stamp</th>
                    <th class="align-middle">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    <tr>
                        <td>@role.Name</td>
                        <td>@role.NormalizedName</td>
                        <td>@role.ConcurrencyStamp</td>
                        <td>
                            <a asp-area="Admin" asp-controller="UserManagement" asp-action="UpdateRole" asp-route-id="@role.Id" class="btn btn-primary btn-sm">Edit</a>
                            <a asp-area="Admin" asp-controller="UserManagement" asp-action="DeleteRole" asp-route-id="@role.Id" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- /.content -->
@section Scripts {
    <script>
        //This code for temp data response fadeOut
        $(document).ready(function () {
            setTimeout(function () {
                $('#response-alert').fadeOut('slow');
            }, 3000);
        });
    </script>
}