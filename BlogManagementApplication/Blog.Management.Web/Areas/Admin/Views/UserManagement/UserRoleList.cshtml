@model IEnumerable<ApplicationRole>

@{
    ViewData["Title"] = "Role List";
}

<style>
    .custom-table-bordered th,
    .custom-table-bordered td {
        border: 1px solid #dee2e6 !important;
    }
</style>

<div class="container-fluid px-5 py-3">
    <!-- Title and Add Button in single line like Users table -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">User Roles</h2>
        <div>
            <partial name="_ResponsePartial" />
            <a asp-area="Admin"
               asp-controller="UserManagement"
               asp-action="CreateRole"
               class="btn btn-success ms-2">
                Add New Role
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered custom-table-bordered mb-0">
            <thead class="table-light">
                <tr>
                    <th class="align-middle">Role Name</th>
                    <th class="align-middle">Normalized Name</th>
                    <th class="align-middle">Concurrency Stamp</th>
                    <th class="align-middle">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    <tr>
                        <td>@role.Name</td>
                        <td>@role.NormalizedName</td>
                        <td>@role.ConcurrencyStamp</td>
                        <td>
                            <a asp-area="Admin"
                               asp-controller="UserManagement"
                               asp-action="UpdateUserRole"
                               asp-route-id="@role.Id"
                               class="btn btn-sm btn-info text-white me-1">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>


                            <form asp-area="Admin"
                                  asp-controller="UserManagement"
                                  asp-action="DeleteUserRole"
                                  asp-route-id="@role.Id"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this user role?');"
                                  style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger text-white me-1">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 0)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="UserRoleList"
                       asp-route-page="@(ViewBag.CurrentPage - 1)">
                        Previous
                    </a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="UserRoleList"
                           asp-route-page="@i">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="UserRoleList"
                       asp-route-page="@(ViewBag.CurrentPage + 1)">
                        Next
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            setTimeout(function () {
                $('#response-alert').fadeOut('slow');
            }, 3000);
        });
    </script>
}
