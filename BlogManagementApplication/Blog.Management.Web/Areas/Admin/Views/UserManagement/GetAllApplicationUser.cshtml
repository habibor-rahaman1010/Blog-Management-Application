@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = "Application User List";
}

<style>
    .custom-table-bordered th,
    .custom-table-bordered td {
        border: 1px solid #dee2e6 !important;
    }
</style>

<div class="container-fluid py-3">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">All Users</h3>
        </div>


        <div class="card-body">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Email Confirmed</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.UserName</td>
                            <td>@user.Email</td>
                            <td>@(user.EmailConfirmed ? "Yes" : "No")</td>
                            <td>
                                <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-info">Edit</a>
                                <a asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


    <!-- Pagination -->
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="GetAllApplicationUser" asp-route-page="@(ViewBag.CurrentPage - 1)">Previous</a>
            </li>


            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="GetAllApplicationUser" asp-route-page="@i">@i</a>
                </li>
            }


            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="GetAllApplicationUser" asp-route-page="@(ViewBag.CurrentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
</div>

<!-- /.content -->
@section Scripts {
    <script>
        $(document).ready(function () {
            setTimeout(function () {
                $('#response-alert').fadeOut('slow');
            }, 3000);
        });
    </script>
}