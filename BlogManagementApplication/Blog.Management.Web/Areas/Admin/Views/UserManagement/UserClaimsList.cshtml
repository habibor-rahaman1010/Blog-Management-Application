@model IEnumerable<UserClaimListModel>

<style>
    .custom-table-bordered th,
    .custom-table-bordered td {
        border: 1px solid #dee2e6 !important;
    }
</style>

<div class="container-fluid px-5 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">User Claims</h2>
        <partial name="_ResponsePartial" />
        <a asp-area="Admin" asp-controller="UserManagement" asp-action="AddUserClaim" class="btn btn-success">Add New Claim</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered custom-table-bordered mb-0">
            <thead class="table-light">
                <tr>
                    <th class="align-middle">User Name</th>
                    <th class="align-middle">Email</th>
                    <th class="align-middle">Claim Type</th>
                    <th class="align-middle">Claim Value</th>
                    <th class="align-middle">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var claimCount = user.Claims.Count;
                    if (claimCount == 0)
                    {
                        <tr>
                            <td>@user.UserName</td>
                            <td>@user.Email</td>
                            <td colspan="3" class="text-center">No claims available</td>
                        </tr>
                    }
                    else
                    {
                        for (int i = 0; i < claimCount; i++)
                        {
                            <tr>
                                @if (i == 0)
                                {
                                    <td rowspan="@claimCount">@user.UserName</td>
                                    <td rowspan="@claimCount">@user.Email</td>
                                }
                                <td>@user.Claims[i].Type</td>
                                <td>@user.Claims[i].Value</td>
                                <td>
                                    <a asp-area="Admin" asp-action="UserClaimEdit" asp-route-userId="@user.UserId" asp-route-claimType="@user.Claims[i].Type" asp-route-claimValue="@user.Claims[i].Value" class="btn btn-primary btn-sm">Edit</a>
                                    <a asp-area="Admin" asp-action="UserClaimDelete" asp-route-userId="@user.UserId" asp-route-claimType="@user.Claims[i].Type" asp-route-claimValue="@user.Claims[i].Value"
                                       class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this claim?');">Delete</a>
                                </td>

                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (ViewBag.TotalPages >= 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">

            <!-- Previous -->
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="UserClaimsList"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-pageSize="@ViewBag.PageSize">
                    Previous
                </a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="UserClaimsList"
                       asp-route-page="@i"
                       asp-route-pageSize="@ViewBag.PageSize">
                        @i
                    </a>
                </li>
            }

            <!-- Next -->
            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="UserClaimsList"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-pageSize="@ViewBag.PageSize">
                    Next
                </a>
            </li>

        </ul>
    </nav>
}


@section Scripts {
    <script>
        // Code for temp data response fadeOut
        $(document).ready(function () {
            setTimeout(function () {
                $('#response-alert').fadeOut('slow');
            }, 3000);
        });
    </script>
}