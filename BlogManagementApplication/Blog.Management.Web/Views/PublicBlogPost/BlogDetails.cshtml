@model BlogPostDto

@{
    ViewData["Title"] = "Blog Details";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <img src="@Url.Content("~/Uploads/BlogImages/" + Model.CoverImageUrl)" class="card-img-top w-50 mx-auto d-block py-3" />

        <div class="card-body">
            <h2 class="card-title">@Model.Title</h2>

            <p class="text-muted">
                Category: <strong>@Model.CategoryName</strong> |
                Author: <strong>@Model.Author</strong> |
                Posted on: <strong>@Model.CreatedAt.ToString("dd MMM yyyy")</strong>
            </p>

            <hr />

            <div>
                @Html.Raw(Model.Content)
            </div>

            <hr />

            @if (Model.UpdatedAt != null)
            {
                <p class="text-muted">Last Updated: @Model.UpdatedAt?.ToString("dd MMM yyyy")</p>
            }

            <a asp-area="" asp-controller="PublicBlogPost" asp-action="BlogPostList" class="btn btn-secondary">Back to Blog List</a>
        </div>
    </div>
</div>

